# Copy to .env and adjust. All variables are optional; defaults serve the Gironde zone.
# No secret is needed by this service.

# Hazard dataset queried on the CLIMADA data API
CLIMRISK_HAZARD_TYPE=river_flood
CLIMRISK_HAZARD_COUNTRY=FRA
CLIMRISK_HAZARD_SCENARIO=historical
CLIMRISK_HAZARD_YEAR_RANGE=1980_2000

# Zone served by this deployment: [lon_min, lat_min, lon_max, lat_max] in EPSG:4326
CLIMRISK_ZONE_BBOX=[-1.3, 44.2, 0.35, 45.6]

# Where prepared data files are written and read
CLIMRISK_DATA_DIR=data

# Guard rail: refuse to download a dataset larger than this (MB)
CLIMRISK_MAX_DOWNLOAD_MB=50
